{
  "name": "clearshelf",
  "version": "1.0.0",
  "private": true,
  "description": "Dev tooling for the Clearshelf Chrome extension. The extension itself has no build step and no runtime dependencies.",
  "scripts": {
    "test": "npm run test:unit && npm run test:engine && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:engine": "node --test --test-concurrency=1 \"tests/engine/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/extension.test.js",
    "bench:accuracy": "node tests/bench/accuracy.js 240 --json docs/results/accuracy.json",
    "bench:perf": "node tests/bench/perf.js 9 --json docs/results/perf.json",
    "icons": "node scripts/build-icons.js",
    "package": "node scripts/package.js"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
